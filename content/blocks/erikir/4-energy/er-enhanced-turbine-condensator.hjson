{
  type: "ThermalGenerator"
  name: "er-enhanced-turbine-condensator"
  localizedName: "Advanced Turbine Condensator"
  description: "Through sharpened tungsten blades and enhanced silicon contacts, this Turbine condensator generates a remarkable amount of extra energy, compared to the base version"
  health: 725
  size: 3
  hasPower: true
  hasItems: false
